@page "/materias/cadastro"
@rendermode InteractiveServer
@using projetogrupo.DAO
@using projetogrupo.Models
@inject MateriaDAO MateriaDAO
@inject NavigationManager NavigationManager

<PageTitle>Nova Matéria - Sistema de Controle</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cadastro de Matéria</h2>
    </div>
</div>

<div class="custom-table-card p-4">
    <EditForm Model="materia" OnValidSubmit="Salvar">
        <DataAnnotationsValidator />

        <ValidationSummary class="alert alert-danger" />

        <div class="row mb-3">
            <div class="col-md-12">
                <label for="nome" class="form-label">
                    Nome
                </label>

                <InputText id="nome"
                           class="form-control"
                           @bind-Value="materia.Nome" />

                <ValidationMessage For="() => materia.Nome" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-12">
                <label for="descricao" class="form-label">
                    Descrição
                </label>

                <InputTextArea id="descricao"
                               class="form-control"
                               rows="4"
                               @bind-Value="materia.Descricao" />

                <ValidationMessage For="() => materia.Descricao" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg"></i>
                Salvar
            </button>

            <a href="/materia" class="btn btn-light border">
                Cancelar
            </a>
        </div>
    </EditForm>
</div>

@code {
    private Materia materia = new();

    private void Salvar()
    {
        MateriaDAO.Inserir(materia);

        NavigationManager.NavigateTo("/materia");
    }
}